{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "clio.episode/1"
    },
    "episodeId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "learn",
        "record_demo",
        "free"
      ]
    },
    "procedure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "description": "Full snapshot of the procedure used; AI-generated plans exist nowhere else",
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "clio.procedure/1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "origin": {
          "default": {
            "kind": "curated"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "curated"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "description": "Hand-written, in procedures/"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "generated"
                },
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The learner's request, e.g. \"add wiper fluid\""
                },
                "model": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "revisionOf": {
                  "description": "Id of the plan this one revises",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "goal",
                "model",
                "createdAt"
              ],
              "additionalProperties": false,
              "description": "Written by the planner LLM at runtime"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string"
        },
        "workspace": {
          "type": "object",
          "properties": {
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2,
              "description": "[width along +x, depth along -z] in meters"
            },
            "marker": {
              "description": "Taped at the origin corner, axes aligned with the workspace; enables marker calibration",
              "type": "object",
              "properties": {
                "family": {
                  "default": "aruco_4x4_50",
                  "type": "string",
                  "enum": [
                    "aruco_4x4_50",
                    "apriltag_36h11"
                  ]
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sizeM": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.5,
                  "description": "Printed black-square edge length in meters"
                },
                "offset": {
                  "default": [
                    0,
                    0,
                    0
                  ],
                  "description": "The object's reference point in the marker frame (meters)",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "family",
                "id",
                "sizeM",
                "offset"
              ],
              "additionalProperties": false
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "size"
          ],
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Spoken and displayed name, e.g. \"cup A\""
              },
              "kind": {
                "default": "item",
                "type": "string",
                "enum": [
                  "point",
                  "item",
                  "container",
                  "tool",
                  "region"
                ]
              },
              "description": {
                "type": "string"
              },
              "radius": {
                "default": 0.03,
                "description": "Approximate size in meters",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 0.5
              },
              "hidden": {
                "default": false,
                "description": "Not drawn; used only by checks (e.g. mistake zones)",
                "type": "boolean"
              },
              "placement": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "layout"
                      },
                      "position": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 3,
                        "maxItems": 3,
                        "description": "Fixed position in the workspace frame (meters)"
                      }
                    },
                    "required": [
                      "method",
                      "position"
                    ],
                    "additionalProperties": false,
                    "description": "Placed automatically from the layout, e.g. a dot on a taped outline."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "register"
                      },
                      "prompt": {
                        "description": "e.g. \"Touch the vinegar bottle and pinch\"",
                        "type": "string"
                      }
                    },
                    "required": [
                      "method"
                    ],
                    "additionalProperties": false,
                    "description": "The user registers it by pinching at it during setup."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "detect"
                      },
                      "hint": {
                        "description": "Where to look, e.g. \"front left of the engine bay\"",
                        "type": "string"
                      }
                    },
                    "required": [
                      "method"
                    ],
                    "additionalProperties": false,
                    "description": "Found by the camera from tracking.query (or the label); falls back to a pinch."
                  }
                ]
              },
              "tracking": {
                "type": "object",
                "properties": {
                  "marker": {
                    "type": "object",
                    "properties": {
                      "family": {
                        "default": "aruco_4x4_50",
                        "type": "string",
                        "enum": [
                          "aruco_4x4_50",
                          "apriltag_36h11"
                        ]
                      },
                      "id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "sizeM": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 0.5,
                        "description": "Printed black-square edge length in meters"
                      },
                      "offset": {
                        "default": [
                          0,
                          0,
                          0
                        ],
                        "description": "The object's reference point in the marker frame (meters)",
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "family",
                      "id",
                      "sizeM",
                      "offset"
                    ],
                    "additionalProperties": false,
                    "description": "A printed fiducial stuck to the object (or taped at the workspace origin)."
                  },
                  "query": {
                    "description": "Open-vocabulary detector prompt, e.g. \"white paper cup with a big letter A\"",
                    "type": "string",
                    "minLength": 1
                  },
                  "moves": {
                    "default": false,
                    "description": "Expected to move during the task, so it is tracked continuously",
                    "type": "boolean"
                  }
                },
                "required": [
                  "moves"
                ],
                "additionalProperties": false,
                "description": "How the camera can find this object. Without it the object stays where placed."
              },
              "partOf": {
                "description": "The declared object this one is a component or a bounded area of (a vernier scale of a caliper); the whole is followed and recorded with it",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "radius",
              "hidden",
              "placement"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Imperative sentence, spoken and shown. This is the language label for the step."
              },
              "doneWhen": {
                "description": "The finished state as a camera or the learner would see it, e.g. \"cup A has turned pink\". The coach and the step watcher judge completion against it.",
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "detail": {
                "type": "string"
              },
              "targets": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                }
              },
              "hand": {
                "default": "either",
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "either",
                  "both"
                ]
              },
              "action": {
                "description": "What the hands do; drives the synthesized demo",
                "type": "object",
                "properties": {
                  "verb": {
                    "type": "string",
                    "enum": [
                      "point_at",
                      "touch",
                      "pinch",
                      "grasp",
                      "pick_up",
                      "place",
                      "pour",
                      "insert",
                      "twist",
                      "press",
                      "pull",
                      "wipe",
                      "fold",
                      "lift",
                      "observe",
                      "wait",
                      "other"
                    ]
                  },
                  "object": {
                    "description": "The object acted on (held, touched, twisted, ...)",
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                  },
                  "target": {
                    "description": "Destination or recipient (place, pour, insert, fold)",
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                  },
                  "hand": {
                    "default": "either",
                    "type": "string",
                    "enum": [
                      "left",
                      "right",
                      "either",
                      "both"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "cw",
                      "ccw",
                      "up",
                      "down",
                      "toward",
                      "away",
                      "left",
                      "right"
                    ]
                  },
                  "amount": {
                    "description": "Turns for twist, meters for lift or pull, seconds for wait",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "verb",
                  "hand"
                ],
                "additionalProperties": false
              },
              "show": {
                "default": [],
                "description": "What to outline in AR during this step, most important first",
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                      "description": "The declared object this item outlines"
                    },
                    "phrase": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60,
                      "description": "2-5 word noun phrase naming it, for category-style detectors: \"blue washer cap\""
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "description": "Standalone visual description a vision model can find and outline in one camera frame: what it is, color, shape, size, text or symbols on it, and where it is now"
                    }
                  },
                  "required": [
                    "object",
                    "phrase",
                    "description"
                  ],
                  "additionalProperties": false,
                  "description": "Something Clio finds with the camera and outlines for the learner during this step."
                }
              },
              "success": {
                "$ref": "#/$defs/Check"
              },
              "mistakes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                      "description": "Machine label, e.g. \"wrong_cup\""
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The correction, e.g. \"That is cup B. Vinegar goes in A.\""
                    },
                    "when": {
                      "$ref": "#/$defs/Check"
                    },
                    "cooldownMs": {
                      "default": 4000,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "message",
                    "when",
                    "cooldownMs"
                  ],
                  "additionalProperties": false
                }
              },
              "demo": {
                "description": "Override the default clip id \"<procedureId>/<stepId>\"",
                "type": "object",
                "properties": {
                  "clipId": {
                    "type": "string"
                  }
                },
                "required": [
                  "clipId"
                ],
                "additionalProperties": false
              },
              "coachNotes": {
                "type": "string"
              },
              "stuckAfterMs": {
                "description": "Nudge the coach after this long",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "instruction",
              "targets",
              "hand",
              "show",
              "success",
              "mistakes"
            ],
            "additionalProperties": false
          }
        },
        "coach": {
          "default": {},
          "type": "object",
          "properties": {
            "persona": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "id",
        "version",
        "origin",
        "title",
        "summary",
        "workspace",
        "objects",
        "steps",
        "coach"
      ],
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "learner",
            "expert",
            "collector"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "timeline": {
          "type": "string",
          "const": "performance.now"
        },
        "startEpochMs": {
          "type": "number",
          "description": "Wall-clock ms at t = 0"
        }
      },
      "required": [
        "timeline",
        "startEpochMs"
      ],
      "additionalProperties": false
    },
    "space": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "string",
          "const": "workspace"
        },
        "units": {
          "type": "string",
          "const": "m"
        },
        "upAxis": {
          "type": "string",
          "const": "+y"
        },
        "worldFromWorkspace": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7,
          "description": "Workspace pose in WebXR local-floor space"
        },
        "calibration": {
          "type": "string",
          "enum": [
            "pinch_two_corners",
            "workspace_marker",
            "persisted_anchor",
            "default_in_front",
            "none"
          ]
        },
        "anchored": {
          "type": "boolean",
          "description": "Workspace pose tracked by a WebXR anchor"
        }
      },
      "required": [
        "frame",
        "units",
        "upAxis",
        "worldFromWorkspace",
        "calibration",
        "anchored"
      ],
      "additionalProperties": false
    },
    "hands": {
      "type": "object",
      "properties": {
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint order used by HandSample.joints"
        },
        "jointFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Values per joint"
        }
      },
      "required": [
        "joints",
        "jointFields"
      ],
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3,
            "description": "[x, y, z] in meters"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "method": {
            "type": "string",
            "enum": [
              "layout",
              "pinch",
              "marker",
              "detector",
              "manual"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "position",
          "radius",
          "method"
        ],
        "additionalProperties": false
      },
      "description": "Object placements when the episode started"
    },
    "coach": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gemini",
            "scripted",
            "none"
          ]
        },
        "model": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "relay",
            "direct"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "emulated": {
          "type": "boolean"
        },
        "xrFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "userAgent",
        "emulated",
        "xrFeatures"
      ],
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "features": {
      "description": "Optional recording features used, e.g. \"object.flags\" and \"object.grasp\"",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "camera": {
      "description": "Passthrough camera model used to lift 2D observations; absent when unknown",
      "type": "object",
      "properties": {
        "intrinsics": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fy": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height",
            "fx",
            "fy",
            "cx",
            "cy"
          ],
          "additionalProperties": false
        },
        "headFromCamera": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7,
          "description": "Camera pose in the head (viewer) frame"
        },
        "source": {
          "type": "string",
          "enum": [
            "lens-metadata",
            "default",
            "calibrated",
            "override"
          ]
        }
      },
      "required": [
