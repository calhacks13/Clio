            "description": "ms since episode start"
          },
          "head": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 7,
            "maxItems": 7,
            "description": "Viewer pose, workspace frame"
          },
          "left": {
            "anyOf": [
              {
