                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "layout",
                    "pinch",
                    "marker",
                    "detector",
                    "manual"
                  ]
                }
