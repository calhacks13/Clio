{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "aborted",
        "interrupted"
      ]
    },
    "stepsCompleted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stepsTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "batches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Batches the client sent, for integrity checks"
    }
  },
  "required": [
    "durationMs",
    "outcome",
    "stepsCompleted",
    "stepsTotal",
    "batches"
  ],
  "additionalProperties": false,
  "$id": "https://clio.dev/schema/episode-finish.schema.json",
  "title": "Clio finish.json"
}
