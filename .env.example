# Copy to .env at the repo root. The server reads it; the headset never sees these values.

# Google AI Studio key (https://aistudio.google.com/apikey). Without it the coach falls back to the
# scripted (offline) coach, and planning and vision return 503.
GEMINI_API_KEY=

# Optional model overrides (defaults in apps/server/src/config.ts). Planning quality depends most on
# GEMINI_PLANNER_MODEL: try a stronger model if plans come out thin.
# The voice coach (realtime, native audio; it is the only model that talks with the learner).
# Default gemini-3.8-live-extended-thinking; gemini-3.8-live is the same without thinking, quicker.
GEMINI_LIVE_MODEL=
GEMINI_PLANNER_MODEL=
GEMINI_VISION_MODEL=
# The smart model the voice asks for a closer look (look_closer, POST /api/scene/ask). Default:
# gemini-robotics-er-2-preview.
GEMINI_SCENE_MODEL=
# Grades planner bench runs against their expectations (docs/planner-bench.md).
GEMINI_JUDGE_MODEL=

# Optional external object finder (e.g. jev): Clio POSTs camera frames and per-step descriptions to
# this URL instead of asking Gemini. Contract: docs/object-finder.md. Token is sent as a Bearer.
CLIO_VISION_URL=
CLIO_VISION_TOKEN=

# The tracker (tracker/, `pnpm tracker`): set CLIO_VISION_URL=http://127.0.0.1:8790/locate to use
# it. It names targets with jev (TYPESAFE_API_KEY) or any finder at CLIO_TRACKER_IDENTIFIER_URL.
# Other settings: tracker/README.md.
TYPESAFE_API_KEY=
CLIO_TRACKER_IDENTIFIER_URL=

# Server. It binds loopback by default: only the local Vite dev server talks to it.
CLIO_SERVER_PORT=8787
CLIO_HOST=127.0.0.1
CLIO_DATA_DIR=./data
CLIO_PROCEDURES_DIR=./procedures
# 1 = log one line per relayed Gemini Live message (type and size only, never content or the key)
CLIO_RELAY_LOG=
