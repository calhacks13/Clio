# Copy to .env at the repo root. The server reads it; the headset never sees these values.

# Google AI Studio key (https://aistudio.google.com/apikey). Without it the coach falls back to the
# scripted (offline) coach and procedure drafting is disabled.
GEMINI_API_KEY=

# Optional model overrides. Leave empty to use the defaults in apps/server/src/config.ts.
GEMINI_LIVE_MODEL=
GEMINI_TEXT_MODEL=

# Server
CLIO_SERVER_PORT=8787
CLIO_DATA_DIR=./data
